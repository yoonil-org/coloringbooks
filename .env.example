# Copy this to .env and fill in your values
# NEVER commit .env to git

# Claude API (from claude.ai account settings or console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Pinterest OAuth2 access token (from Pinterest Developer portal)
# Scopes needed: pins:read, pins:write, boards:read
PINTEREST_ACCESS_TOKEN=

# Optional: hardcode your Pinterest board ID (otherwise auto-detected)
PINTEREST_BOARD_ID=

# Gmail for alert emails (use an App Password, not your real password)
# Enable 2FA on Gmail, then create App Password at myaccount.google.com/apppasswords
GMAIL_USER=yoonil.choi@gmail.com
GMAIL_APP_PASSWORD=
